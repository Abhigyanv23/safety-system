# Safety backend / Raspberry Pi (or dev-server) Socket.IO + HTTP base URL
# Local development (dev-server on your machine):
NEXT_PUBLIC_SAFETY_BACKEND_URL=http://localhost:5001

# When the Raspberry Pi backend is on another device on the same
# network, replace localhost with the Pi's LAN IP (find it on the Pi
# with `hostname -I`). Example:
# NEXT_PUBLIC_SAFETY_BACKEND_URL=http://192.168.1.50:5001

# Mock data mode.
# true  -> dashboard generates its own mock telemetry for W01 whenever
#          no real backend is connected (useful with no hardware/dev-server
#          running at all).
# false -> dashboard NEVER fabricates data; it only shows what arrives
#          over the socket connection above. Set this to false once the
#          real Raspberry Pi backend (or safety-server + simulator) is
#          up and you want the dashboard to reflect only real telemetry.
NEXT_PUBLIC_SAFETY_MOCK_MODE=true
